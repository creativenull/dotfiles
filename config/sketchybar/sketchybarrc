## Plugins
PLUGIN_DIR="$CONFIG_DIR/plugins"

## Theme variables
light_text_color=0xfffafafa
light_bg_color=0x55262626

dark_text_color=0xfffafafa
dark_bg_color=0x33e5e5e5

theme_height=30

## Bar Properties
sketchybar --bar position=top height=40 y_offset=1 color=0x00000000 padding_left=10 padding_right=10

sketchybar --default \
	icon.font="SF Pro:Semibold:13.0" \
	label.font="SF Pro:Semibold:13.0"

## Left
## ---
SPACE_ICONS=("1" "2" "3" "4")
for i in "${!SPACE_ICONS[@]}"
do
  sid="$(($i+1))"
  space=(
	space="$sid"
	icon="${SPACE_ICONS[i]}"
	icon.padding_left=10
	icon.padding_right=10
	icon.highlight_color=0xff000000
	background.color=${light_bg_color}
	background.corner_radius=8
	background.height=${theme_height}
	label.drawing=off
	script="$PLUGIN_DIR/space.sh"
  )
  sketchybar --add space space."$sid" left
  sketchybar --set space."$sid" "${space[@]}"
  sketchybar --add item space.gap left
  sketchybar --set space.gap label.drawing=off icon.padding_left=1 icon.padding_right=1
done

sketchybar --add item lgap1 left
sketchybar --set lgap1 label.drawing=off icon.padding_left=5

sketchybar --add item front_app left
sketchybar --subscribe front_app front_app_switched
sketchybar --set front_app \
	icon.drawing=off \
	label.padding_left=10 \
	label.padding_right=10 \
	label.color=${light_text_color} \
	background.color=${light_bg_color} \
	background.corner_radius=8 \
	background.height=${theme_height} \
	background.blur_radius=10 \
	script="$PLUGIN_DIR/front_app.sh"

